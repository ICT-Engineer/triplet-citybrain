# Copy to .env and replace every example value with a fresh random secret before startup.
# Keep .env local; do not commit it or share it in chat.

# Twin requires four unique tokens, each >=32 characters and containing >=16 distinct characters.
TWIN_TOKEN_BRAIN=replace-with-a-fresh-random-brain-token-000000000000000000
TWIN_TOKEN_GUARDIAN=replace-with-a-fresh-random-guardian-token-111111111111
TWIN_TOKEN_OPERATOR=replace-with-a-fresh-random-operator-token-222222222222
TWIN_TOKEN_EVALUATOR=replace-with-a-fresh-random-evaluator-token-333333333333
TWIN_DASHBOARD_SECRET=replace-with-a-fresh-random-dashboard-passphrase-777777777

# Guardian's admin token and scoped Brain / timeline tokens must all be distinct.
GUARDIAN_TOKEN=replace-with-a-fresh-random-guardian-admin-token-444444444
GUARDIAN_TOKEN_BRAIN=replace-with-a-fresh-random-guardian-read-token-5555555555
GUARDIAN_TOKEN_TIMELINE=replace-with-a-fresh-random-guardian-timeline-token-666666666
